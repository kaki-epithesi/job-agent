# Environment
ENV=development
DEBUG=false

# HTTP
HTTP_TIMEOUT=30
HTTP_RETRIES=3

# Browser (experimental LinkedIn connector)
HEADLESS=false
BROWSER_TIMEOUT=30000
PROFILE_NAME=linkedin

# Discovery
SOURCES_FILE=
REQUEST_DELAY=3
MAX_SCROLLS=25
MAX_CONCURRENCY=4

# Matching
RESUME_FILE=

# Email (SMTP) — see README "Email notifications" for Gmail setup
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=          # use a Gmail App Password, not your account password
SMTP_FROM=
SMTP_TO=

# Database (async SQLite; Postgres supported later)
DATABASE_URL=sqlite+aiosqlite:///data/database.db

# Logging
LOG_LEVEL=INFO
